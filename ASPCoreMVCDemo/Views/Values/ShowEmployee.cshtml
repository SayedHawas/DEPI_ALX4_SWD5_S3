@model ASPCoreMVCDemo.Models.Employee

<h3> Show Employee Details </h3>
@if(Model!=null)
{
    <div class="card" style="width:400px">
        <img class="card-img-top" src="~/Files/2.jpg" alt="Card image">
        <div class="card-body">
            <h4 class="card-title">@Model.Name</h4>
            <p class="card-text">@Model.Department</p>
            <a href="#" class="btn btn-primary">@Model.Salary.ToString("C")</a>
        </div>
    </div>
}