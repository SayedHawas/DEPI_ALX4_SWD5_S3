@model List<ASPCoreMVCDemo.Models.Category>
@{
    ViewData["Title"] = "Category Page";
}
<h1> List Of Categories </h1>
<hr />
@* <a href="/Categories/Create"> Create </a> *@
<br />
@* HTML Helper  .Net  .Net Core *@
@* @Html.ActionLink("Create" , "Create") *@
<br />
@*Tag Core  *@
<a asp-action="Create" asp-controller="Categories" class="btn btn-primary" > Create </a>

<hr />

<table class="table table-boarder">
    <tr>
        <th>@Html.DisplayNameFor(mo=>Model[0].Name) </th>
        <th>@Html.DisplayNameFor(mo => Model[0].Description) </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                <a href="/Categories/Details/@item.CategoryId"> Details </a> |
                <a href="/Categories/Edit/@item.CategoryId"> Edit </a> |
                <a href="/Categories/Delete/@item.CategoryId"> Delete </a>
            </td>
        </tr>
    }
</table>